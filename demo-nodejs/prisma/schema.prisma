generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model category {
  id             Int        @id @default(autoincrement())
  parent_id      Int?
  name           String
  parent         category?  @relation("categoryTocategory", fields: [parent_id], references: [id], onDelete: NoAction)
  children       category[] @relation("categoryTocategory")
  content        content[]

  @@unique([parent_id, name], map: "category_parent_id_name_key")
}

model content {
  id          Int       @id @default(autoincrement())
  category_id Int?
  content     String
  category    category? @relation(fields: [category_id], references: [id], onDelete: NoAction)
}
